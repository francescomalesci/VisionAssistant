# Copy this file to .env and fill in the values for your machine.
# .env is gitignored: your personal paths/URLs never get committed.

# Path to the folder containing cublas64_12.dll / cudnn*.dll, extracted from
# the Faster-Whisper-XXL Windows release (see README > Setup).
FASTER_WHISPER_DLL_DIR=C:\path\to\Faster-Whisper-XXL\_xxl_data\torch\lib

# Whisper model size: tiny / base / small / medium / large-v3
WHISPER_MODEL_SIZE=small

# Ollama model tags (must be already pulled: `ollama pull <tag>`)
LLM_MODEL=qwen2.5:7b
# On GPUs with less than ~8GB VRAM, use a lighter VLM, e.g. "moondream"
VLM_MODEL=qwen2.5vl:3b

# openWakeWord model name and detection threshold (0-1, higher = stricter)
WAKE_WORD_MODEL=alexa
WAKE_WORD_THRESHOLD=0.75

# Piper TTS voice files (download from https://github.com/rhasspy/piper-voices)
PIPER_MODEL_PATH=it_IT-serena-medium.onnx
PIPER_CONFIG_PATH=it_IT-serena-medium.onnx.json

# IP Webcam / DroidCam stream URL (check the app on your phone for the
# current local IP — it changes when the phone reconnects to Wi-Fi)
CAMERA_STREAM_URL=http://192.168.1.100:8080/video

# Local web UI bridge (server.py)
UI_SERVER_URL=http://127.0.0.1:8000
